# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file to Git.

PORT=5000
NODE_ENV=development

# MongoDB Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/artisanai
# Local MongoDB example: mongodb://127.0.0.1:27017/artisanai
MONGODB_URI=

# The frontend address allowed to call this backend (CORS)
CLIENT_URL=http://localhost:3000

# Base URL used to build public links for uploaded images
PUBLIC_BASE_URL=http://localhost:5000

# Login tokens: use a long random text (30+ characters)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# "mock" = demo payment, "razorpay" = real Razorpay test payment
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI settings (add only if you enable AI discovery)
LLM_PROVIDER=gemini   # provider (currently only gemini supported)
GEMINI_API_KEY=       # your Gemini API key (leave empty to force fallback)
LLM_MODEL=gemini-2.5-flash   # model name; defaults to gemini-2.5-flash if not set
AI_DAILY_LIMIT=300    # max AI requests per day per server instance
